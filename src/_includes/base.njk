<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} - {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description | default(site.description) }}">
    <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
    <div class="terminal">
        <header class="terminal-header">
{% if title == 'home' %}<pre class="ascii-banner" aria-hidden="true">{{ asciiHero }}</pre>
{% endif %}
            <h1>{{ site.name | upper }}</h1>
            <p class="subtitle">{{ site.description }}</p>
        </header>

        <main class="terminal-body">
            {{ content | safe }}
        </main>

        {% if title == 'home' %}<footer class="terminal-footer">
            <nav class="social-nav">
                <a href="{{ site.socials.github }}">github</a>
                <a href="{{ site.socials.youtube }}">youtube</a>
                <a href="{{ site.socials.instagram }}">instagram</a>
                <a href="{{ site.socials.email }}">email</a>
            </nav>
        </footer>{% endif %}
    </div>
</body>
</html>